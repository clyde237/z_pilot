# Copy to .env and fill in. Never commit .env.
# Each environment (development, Vercel preview, production) uses its own Neon branch
# and its own secrets. The Neon integration for Vercel sets both database variables.

# Pooled connection string (host contains "-pooler"), used by the application.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/z_pilot?sslmode=verify-full"

# Direct connection string, used by drizzle-kit for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/z_pilot?sslmode=verify-full"

# Random string of at least 32 characters, e.g. `openssl rand -base64 32`.
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
